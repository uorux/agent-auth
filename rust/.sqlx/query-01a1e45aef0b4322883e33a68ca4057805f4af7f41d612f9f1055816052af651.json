  "query": "SELECT l.item, l.slot, l.agent_id, l.agent_slot, l.grant_id, g.expires_at\n         FROM pool_leases l JOIN grants g ON g.id = l.grant_id\n         WHERE l.pool = $1\n         ORDER BY l.created_at, l.id",
