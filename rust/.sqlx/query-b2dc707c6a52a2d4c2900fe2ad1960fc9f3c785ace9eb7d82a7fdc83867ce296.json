  "db_name": "PostgreSQL",
  "query": "SELECT j.spec, j.status, j.error, s.purpose AS \"scope_purpose?\",\n                  count(*) OVER () AS \"total!\"\n           FROM host_jobs j\n           LEFT JOIN shell_scope_jobs l ON l.job_id = j.id\n           LEFT JOIN shell_scopes s ON s.id = l.scope_id\n           WHERE j.shell_id = $1\n           ORDER BY j.created_at DESC, j.id DESC LIMIT $2",
