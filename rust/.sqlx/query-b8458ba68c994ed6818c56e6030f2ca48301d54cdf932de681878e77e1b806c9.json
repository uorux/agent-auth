  "query": "WITH RECURSIVE tree AS (\n             SELECT id FROM agents WHERE id = $1\n             UNION\n             SELECT a.id FROM agents a JOIN tree t ON a.parent_agent_id = t.id\n         )\n         UPDATE agents SET disabled = true WHERE id IN (SELECT id FROM tree)\n         RETURNING id, name",
